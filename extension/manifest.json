{
  "manifest_version": 3,
  "name": "leavemealone",
  "version": "0.2.0",
  "description": "Bunk calculator and low-attendance alerts for the CUE student portal. Unofficial; not affiliated with CHRIST University.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://cue.christuniversity.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "leavemealone"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css"
      ],
      "matches": [
        "https://cue.christuniversity.in/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cue.christuniversity.in/*"
      ],
      "js": [
        "calc.js",
        "calendar.js",
        "plan.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
